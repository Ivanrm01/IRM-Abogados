# Copia este fichero a .env.local y rellena los valores reales.
# .env.local NO se sube al repositorio.
# En producción, estos valores van en Vercel → Settings → Environment Variables.

# --- Base de datos (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ La service_role salta el control de acceso: acceso total.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesiones del panel /admin ---
# Cadena larga y aleatoria. Genérala con: openssl rand -base64 48
SESSION_SECRET=

# --- Formulario de contacto (SMTP de IONOS) ---
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=correo@irmabogados.es

# --- Medición (solo se cargan si el usuario acepta cookies) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
